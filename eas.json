{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_NEXA_API_URL": "https://nexa-backend-wallet-v15-staging.onrender.com/api/v1",
        "EXPO_PUBLIC_NEXA_FINANCIAL_EXECUTION_ENABLED": "false",
        "EXPO_PUBLIC_NEXA_RELEASE_CHANNEL": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "primeiros-nexa-preview",
      "env": {
        "EXPO_PUBLIC_NEXA_API_URL": "https://nexa-backend-wallet-v15-staging.onrender.com/api/v1",
        "EXPO_PUBLIC_NEXA_FINANCIAL_EXECUTION_ENABLED": "false",
        "EXPO_PUBLIC_NEXA_RELEASE_CHANNEL": "preview"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_NEXA_API_URL": "https://nexa-backend-p2u0.onrender.com/api/v1",
        "EXPO_PUBLIC_NEXA_FINANCIAL_EXECUTION_ENABLED": "false",
        "EXPO_PUBLIC_NEXA_RELEASE_CHANNEL": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-safe-preview": {
